# ==========================================
# TOMATOAI - Environment Configuration Template
# ==========================================
# Sao chép file này thành .env và điền các giá trị tương ứng của bạn.
# Tuyệt đối KHÔNG commit file .env chứa thông tin bí mật lên Git.

# --- 1. TELEGRAM BOT API ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_ALERT_CHAT_ID=your_telegram_chat_id_for_alerts

# --- 2. GROQ CLOUD API (LLMs & Speech-to-Text) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3

# --- 3. HUGGING FACE INFERENCE SPACES ---
HUGGINGFACE_API_TOKEN=hf_your_huggingface_token_here
HF_LEAF_DISEASE_URL=https://vanle02-tomatoai-leaf-disease.hf.space/predict
HF_RIPENESS_URL=https://vanle02-tomatoai-n8n.hf.space/predict
HF_CRAWLER_NEWS_URL=https://vanle02-price-news-crawler.hf.space/news
HF_CRAWLER_PRICE_URL=https://vanle02-price-news-crawler.hf.space/price

# --- 4. MQTT BROKER (IoT Sensor Stream) ---
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_TOPIC=garden/tomato/data

# --- 5. GOOGLE SHEETS SPREADSHEET IDs ---
# Cấu hình OAuth2 cho Google Sheets trong n8n Credentials
GOOGLE_SHEET_SENSOR_DATA_ID=your_google_sheet_sensor_data_id
GOOGLE_SHEET_CONFIG_ID=your_google_sheet_user_config_id
GOOGLE_SHEET_DAILY_REPORT_ID=your_google_sheet_daily_report_id
GOOGLE_SHEET_CHAT_HISTORY_ID=your_google_sheet_chat_history_id
GOOGLE_SHEET_USER_PROFILE_ID=your_google_sheet_user_profile_id
